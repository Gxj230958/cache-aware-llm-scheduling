@@ -0,0 +1,48 @@
+import unittest
+
+from vllm_ascend.core.compute_service import CostModel, ServiceLedger, Work
+
+
+class ServiceTest(unittest.TestCase):
+    def test_cache_and_chunk_accounting(self):
+        model = CostModel(1.0, 2.0, 0.5, 3.0)
+        hit = Work("hit", "a", 16, 1024, 1040, 1024)
+        cold = Work("cold", "b", 16, 0, 1040)
+        costs = model.batch([hit, cold])
+        self.assertEqual(hit.prefill_tokens, 16)
+        self.assertEqual(sum(costs.values()), 1 + 2 * 32 + 0.5 * (hit.attention_pairs + cold.attention_pairs))
+        # Cached tokens have no projections or MLP cost but remain attention keys.
+        self.assertEqual(costs["hit"] - costs["cold"], 0.5 * 16 * 1024)
+        decode = Work("d", "a", 1, 1040, 1040, 1024)
+        self.assertEqual(decode.decode_tokens, 1)
+        self.assertEqual(decode.attention_pairs, 1041)
+
+    def test_weights_and_batch_reservation(self):
+        ledger = ServiceLedger()
+        work = [Work(str(i), "a" if i < 4 else "b", 1, 0, 1) for i in range(8)]
+        for item in work:
+            ledger.arrive(item.request_id, item.user, 2 if item.user == "a" else 1)
+        costs = {item.request_id: 1.0 for item in work}
+        order = ledger.order(work, costs)
+        self.assertEqual(order[:3], ["0", "4", "1"])
+        self.assertEqual(ledger.service, {"a": 0.0, "b": 0.0})
+        ledger.charge(work, costs)
+        self.assertEqual(ledger.virtual, {"a": 2.0, "b": 4.0})
+
+    def test_returning_user_cannot_bank_idle_credit(self):
+        ledger = ServiceLedger()
+        ledger.arrive("a1", "a")
+        ledger.arrive("b1", "b")
+        ledger.charge([Work("a1", "a", 1, 0, 1), Work("b1", "b", 1, 0, 1)], {"a1": 5.0, "b1": 10.0})
+        ledger.depart("a1")
+        ledger.charge([Work("b1", "b", 1, 0, 1)], {"b1": 10.0})
+        ledger.arrive("a2", "a")
+        self.assertEqual(ledger.virtual["a"], 20.0)
+        ledger.depart("a2")
+        ledger.depart("b1")
+        ledger.arrive("new", "c")
+        self.assertEqual(ledger.virtual["c"], 20.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
